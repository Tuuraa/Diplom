<ui:FluentWindow
    x:Class="WPFComponents.View.FirstLaunchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    xmlns:viewmodels="clr-namespace:WPFComponents.ViewModel"
    xmlns:local="clr-namespace:WPFComponents.View"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Добро пожаловать"
    Height="550" Width="420"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель навигации -->
        <Border Grid.Column="0" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <!-- Индикаторы шагов -->
                <Border x:Name="Step1Indicator" 
                        Width="40" Height="40" 
                        Margin="0,10"
                        CornerRadius="20"
                        Background="{DynamicResource SystemAccentColorBrush}">
                    <TextBlock Text="1" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="Step2Indicator" 
                        Width="40" Height="40" 
                        Margin="0,10"
                        CornerRadius="20"
                        Background="LightGray">
                    <TextBlock Text="2" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Foreground="Gray"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="Step3Indicator" 
                        Width="40" Height="40" 
                        Margin="0,10"
                        CornerRadius="20"
                        Background="LightGray">
                    <TextBlock Text="3" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Foreground="Gray"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="Step4Indicator" 
                        Width="40" Height="40" 
                        Margin="0,10"
                        CornerRadius="20"
                        Background="LightGray">
                    <wpfui:SymbolIcon Symbol="Checkmark24"
                                      FontSize="20"
                                      Foreground="Gray"
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Column="1" Margin="30">
            <TabControl x:Name="MainTabControl" 
                        TabStripPlacement="Left"
                        Style="{x:Null}"
                        Background="Transparent"
                        BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- Вкладка 1: Приветствие -->
                <TabItem>
                    <StackPanel VerticalAlignment="Center">
                        <wpfui:SymbolIcon Symbol="PersonVoice24" 
                                          FontSize="64" 
                                          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                          Margin="0,0,0,30"
                                          HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding WelcomeTitle}" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   TextAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding WelcomeMessage}"
                                   FontSize="14"
                                   TextAlignment="Center" 
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   LineHeight="22"
                                   Margin="0,0,0,40"/>

                        <wpfui:Button Content="Начать настройку" 
                                      HorizontalAlignment="Center"
                                      Padding="30,12"
                                      FontSize="14"
                                      FontWeight="Medium"
                                      Command="{Binding NextStepCommand}"/>
                    </StackPanel>
                </TabItem>

                <!-- Вкладка 2: Настройки голоса -->
                <TabItem>
                    <StackPanel VerticalAlignment="Center">
                        <wpfui:SymbolIcon Symbol="Settings24"
                          FontSize="48"
                          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                          Margin="0,0,0,25"
                          HorizontalAlignment="Center" />
                        <TextBlock Text="Настройки приложения"
                   FontSize="24"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,10" />
                        <TextBlock Text="Настройте параметры работы приложения под ваши предпочтения"
                   FontSize="13"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,30" />

                        <!-- Автоматическая генерация настроек -->
                        <ItemsControl ItemsSource="{Binding Settings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:SettingControl/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Кнопки навигации -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                            <wpfui:Button Content="Назад"
                          Appearance="Secondary"
                          Margin="0,0,10,0"
                          Padding="20,10"
                          Command="{Binding PreviousStepCommand}"
                          IsEnabled="{Binding CanGoPrevious}" />
                            <wpfui:Button Content="Далее"
                          Padding="20,10"
                          Command="{Binding NextStepCommand}"
                          IsEnabled="{Binding CanGoNext}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>


                <!-- Вкладка 3: Разрешения -->
                <TabItem>
                    <StackPanel VerticalAlignment="Center">
                        <wpfui:SymbolIcon Symbol="Shield24" 
                                          FontSize="48" 
                                          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                          Margin="0,0,0,25"
                                          HorizontalAlignment="Center"/>

                        <TextBlock Text="Разрешения" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   TextAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Предоставьте необходимые разрешения для корректной работы"
                                   FontSize="13"
                                   TextAlignment="Center" 
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,30"/>

                        <wpfui:Card Margin="0,0,0,20" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <wpfui:SymbolIcon Symbol="Mic24" FontSize="20" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Доступ к микрофону" FontWeight="Medium"/>
                                        <TextBlock Text="Для распознавания голосовых команд" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <wpfui:SymbolIcon Symbol="Speaker220" FontSize="20" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Доступ к аудио" FontWeight="Medium"/>
                                        <TextBlock Text="Для воспроизведения ответов" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <wpfui:SymbolIcon Symbol="Globe24" FontSize="20" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Доступ к интернету" FontWeight="Medium"/>
                                        <TextBlock Text="Для получения актуальной информации" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </wpfui:Card>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <wpfui:Button Content="Назад" 
                                          Appearance="Secondary"
                                          Margin="0,0,10,0"
                                          Padding="20,10"
                                          Command="{Binding PreviousStepCommand}"
                                          IsEnabled="{Binding CanGoPrevious}"/>
                            <wpfui:Button Content="Предоставить разрешения" 
                                          Padding="20,10"
                                          Command="{Binding RequestPermissionsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- Вкладка 4: Завершение -->
                <TabItem>
                    <StackPanel VerticalAlignment="Center">
                        <wpfui:SymbolIcon Symbol="CheckmarkCircle24" 
                                          FontSize="64" 
                                          Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                          Margin="0,0,0,30"
                                          HorizontalAlignment="Center"/>

                        <TextBlock Text="Всё готово!" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   TextAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Голосовой ассистент успешно настроен и готов к использованию. Теперь вы можете начать работу с ним."
                                   FontSize="14"
                                   TextAlignment="Center" 
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   LineHeight="22"
                                   Margin="0,0,0,40"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <wpfui:Button Content="Назад" 
                                          Appearance="Secondary"
                                          Margin="0,0,15,0"
                                          Padding="20,10"
                                          Command="{Binding PreviousStepCommand}"
                                          IsEnabled="{Binding CanGoPrevious}"/>
                            <wpfui:Button Content="Завершить" 
                                          Padding="25,10"
                                          FontWeight="Medium"
                                          Command="{Binding FinishCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</ui:FluentWindow>