<Window x:Class="WPFComponents.View.ScenarioBuilder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFComponents.View"
        mc:Ignorable="d"
        Title="ScenarioBuilder" Height="450" Width="800">
    <Grid>
        <!-- Основная сетка -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Левая панель -->
            <ColumnDefinition Width="*"/>
            <!-- Область конструктора -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Основное поле -->
            <RowDefinition Height="50"/>
            <!-- Кнопки управления -->
        </Grid.RowDefinitions>

        <!-- Панель команд -->
        <StackPanel Grid.Column="0" Background="DarkGray" VerticalAlignment="Stretch">
            <TextBlock Text="Доступные команды" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button Foreground="Black" Content="Запустить файл" Margin="0,5" PreviewMouseMove="Button_PreviewMouseMove"/>
            <Button Foreground="Black" Content="Нажать кнопку" Margin="0,5" PreviewMouseMove="Button_PreviewMouseMove"/>
            <Button Foreground="Black" Content="Ввести текст" Margin="0,5" PreviewMouseMove="Button_PreviewMouseMove"/>
        </StackPanel>

        <!-- Область конструктора -->
        <Canvas Grid.Column="1" Background="Black" AllowDrop="True" x:Name="ScenarioCanvas" Drop="ScenarioCanvas_Drop" DragOver="ScenarioCanvas_DragOver">
            <!-- Здесь будут размещаться блоки с командами -->
            <TextBlock Text="Перетащите команды сюда" FontStyle="Italic" Opacity="0.5" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
        </Canvas>

        <!-- Нижняя панель кнопок -->
        <StackPanel Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" >
            <Button Content="Сохранить" Foreground="White" Width="100" Margin="5,5,50,5"/>
            <Button Content="Загрузить" Foreground="White" Width="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
