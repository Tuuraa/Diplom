<Page
    x:Class="WPFComponents.View.UserInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="clr-namespace:WPFComponents.ViewModel"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml">


    <Grid VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Как тебя зовут?" FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0 0 0 10"/>
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 20" />

            <wpfui:Button Content="Продолжить"
                          Command="{Binding ContinueCommand}"
                          IsEnabled="{Binding IsValid}" />
        </StackPanel>
    </Grid>
</Page>