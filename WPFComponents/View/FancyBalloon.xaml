<UserControl x:Class="WPFComponents.View.FancyBalloon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFComponents.View"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="300">
    <Border BorderBrush="Black" BorderThickness="2" Background="FloralWhite" Padding="10">
        <Grid>
            <TextBlock x:Name="MessageTextBlock" FontSize="14" VerticalAlignment="Top" TextWrapping="Wrap" Height="44" Margin="0,10,0,0"/>
            <Button x:Name="AgreeButton" Content="Согласен" Width="100" Height="30" Click="AgreeButton_Click" Margin="176,62,0,0" VerticalAlignment="Top" Foreground="Black">
                <Button.Background>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveCaptionTextColorKey}}"/>
                </Button.Background>
                <Button.BorderBrush>
                    <LinearGradientBrush EndPoint="0,3" MappingMode="Absolute">
                        <GradientStop Color="#18FFFFFF" Offset="0.33"/>
                        <GradientStop Offset="0.625" Color="{DynamicResource {x:Static SystemColors.ActiveBorderColorKey}}"/>
                    </LinearGradientBrush>
                </Button.BorderBrush>
            </Button>
        </Grid>
    </Border>
</UserControl>
