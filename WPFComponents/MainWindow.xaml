<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFComponents"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="WPFComponents.MainWindow"
        mc:Ignorable="d"
        Title="Настройки SkyAI" 
        Height="550" 
        Width="420"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.RenderTransform>
        <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1" />
    </Window.RenderTransform>

    <Grid Cursor="">

        <Grid.RowDefinitions>
            <RowDefinition Height="0.06*"/>
            <RowDefinition Height="0.94*"/>
        </Grid.RowDefinitions>

        <Border CornerRadius="15" Grid.RowSpan="2"
                Background="FloralWhite" />
        <ui:SymbolIcon PreviewMouseDown="MinimizeToTray" Cursor="Hand" Symbol="DismissCircle12" FontSize="25" Margin="371,0,0,0"></ui:SymbolIcon>

        <Grid Margin="10 0 10 20" Grid.Row="1" Cursor="">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="0.2*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Margin="10 0 0 0" Text="SkyAI" FontSize="36" FontWeight="Bold" VerticalAlignment="Top"
                       Foreground="Black" HorizontalAlignment="Left" Grid.Column="0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                        VerticalAlignment="Top" Grid.Column="1" Margin="0 15 10 0">
                <TextBlock Text="Settings" PreviewMouseDown="OpenSettings"
                           Foreground="Black" FontSize="18" FontWeight="Bold" 
                           Margin="10,0,0,0" Cursor="Hand"/>

                <TextBlock Text="Docs" Margin="10,0,0,0" Cursor="Hand"
                           Foreground="Black" FontSize="18" FontWeight="Bold"/>
            </StackPanel>

            <Canvas x:Name="MyCanvas" Background="FloralWhite" 
                    Margin="40,40,40,10" Grid.Row="1" Grid.ColumnSpan="2">
                <Polyline x:Name="waveLine" Stroke="Black" StrokeThickness="2" />
            </Canvas>

            <TextBox x:Name="RecognitionTextBox" Width="360" Height="120"
                     TextWrapping="Wrap" Margin="20,0,20,20" Grid.RowSpan="2"
                     VerticalAlignment="Bottom" SelectionOpacity="0" Visibility="Hidden"/>

            <Grid Grid.Row="2" Grid.ColumnSpan="2" Cursor="">

                <Image Source="pack://application:,,,/WPFComponents;component/Media/Icons/close_window.png" HorizontalAlignment="Left"
                       Margin="15 0 0 0" Height="30" x:Name="isActiveMicro"/>
                <TextBlock x:Name="devTeam" Text="Developed by ZXC Team" Foreground="Black"
                           FontWeight="Bold" VerticalAlignment="Center" 
                           HorizontalAlignment="Right" Margin="10"/>

            </Grid>
        </Grid>
    </Grid>
</Window>
